/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/help/*
  Cache-Control: public, max-age=300
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/release.json
  Cache-Control: no-store
